<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/w_round" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
        <LinearLayout android:id="@+id/w_stats" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Stock estimé" android:textSize="13sp" android:textStyle="bold" android:textColor="#41493F" />
            <TextView android:id="@+id/w_stock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="— g" android:textSize="38sp" android:textStyle="bold" android:textColor="#181D18"
                android:includeFontPadding="false" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" />
            <TextView android:id="@+id/w_line" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Ouvre Topé pour démarrer" android:textSize="12sp" android:textColor="#41493F"
                android:maxLines="2" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginLeft="10dp">
            <FrameLayout android:id="@+id/w_btn_achat" android:layout_width="112dp" android:layout_height="44dp">
                <ImageView android:id="@+id/w_btn_achat_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/w_pill" android:scaleType="fitXY" />
                <TextView android:id="@+id/w_btn_achat_tx" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:text="J’ai topé" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF" />
            </FrameLayout>
            <FrameLayout android:id="@+id/w_btn_pesee" android:layout_width="112dp" android:layout_height="44dp" android:layout_marginTop="8dp">
                <ImageView android:id="@+id/w_btn_pesee_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/w_pill" android:scaleType="fitXY" />
                <TextView android:id="@+id/w_btn_pesee_tx" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:text="Pesée" android:textSize="15sp" android:textStyle="bold" android:textColor="#0D1F13" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
